# Huckleberry 登录信息（只保存在本机的 .env 中）
HUCKLEBERRY_EMAIL=
HUCKLEBERRY_PASSWORD=
BABY_NAME=宝宝
TIMEZONE=America/Los_Angeles

# 运行 `uv run hb-homepod scan` 后填入 HomePod 的稳定标识
HOMEPOD_ID=
HOMEPOD_VOLUME=70

# 多个儿童资料时才需要填写
HUCKLEBERRY_CHILD_ID=

SLEEP_LEAD_MINUTES=15
SLEEP_ANNOUNCE_LEAD_MINUTES=16
SLEEP_NAP_SCHEDULE=3
FEED_LEAD_MINUTES=30
FEED_ANNOUNCE_AFTER_MINUTES=149

# 上次喂奶后 3 小时为下次时间，并提前 30 分钟播报
FEED_INTERVAL_MINUTES=180
POLL_SECONDS=60

# 21:00（含）至次日 08:00（不含）不播报
QUIET_START_HOUR=21
QUIET_END_HOUR=8

# 设为 1 时只打印提示，不向 HomePod 播放
DRY_RUN=0
