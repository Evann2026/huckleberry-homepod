# Huckleberry credentials (stored only in your local .env file)
HUCKLEBERRY_EMAIL=
HUCKLEBERRY_PASSWORD=
BABY_NAME=宝宝
TIMEZONE=America/Los_Angeles

# Run `uv run hb-homepod scan`, then enter the HomePod identifier
HOMEPOD_ID=
HOMEPOD_VOLUME=70
MUSIC_HOMEPOD_ID=
# Optional local IP for direct RAOP connection (recommended)
MUSIC_HOMEPOD_HOST=
MUSIC_FILE=
MUSIC_VOLUME=20

# Only required when the account contains multiple child profiles
HUCKLEBERRY_CHILD_ID=

SLEEP_LEAD_MINUTES=15
SLEEP_ANNOUNCE_LEAD_MINUTES=16
SLEEP_NAP_SCHEDULE=3
FEED_LEAD_MINUTES=30
FEED_ANNOUNCE_AFTER_MINUTES=179

# The next feeding is 3.5 hours after the previous one
FEED_INTERVAL_MINUTES=210
POLL_SECONDS=60

# Do not announce from 19:30 (inclusive) until 08:00 (exclusive)
QUIET_START_TIME=19:30
QUIET_END_TIME=08:00

# Set to 1 to print reminders without playing them on the HomePod
DRY_RUN=0
